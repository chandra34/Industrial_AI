APP_NAME="RAG Milvus App"
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=50

# Options: 'pymupdf' or 'docling'
DOCUMENT_PARSER=pymupdf

#---------------------------------- Milvus --------------------------------
MILVUS_COLLECTION_NAME=rag_documents
MILVUS_ALIAS=default

# Scenario 1: Local Milvus Lite (default)
MILVUS_URI=./milvus_local.db
MILVUS_INDEX_TYPE=FLAT

# Scenario 2: Remote / Managed Zilliz Cloud (Uncomment to use)
# MILVUS_URI=https://your-zilliz-instance.cloud.zilliz.com
# MILVUS_TOKEN=your_zilliz_token_here
# MILVUS_INDEX_TYPE=HNSW

MILVUS_DIMENSION=1536
MILVUS_METRIC_TYPE=IP
MILVUS_M=16
MILVUS_EF_CONSTRUCTION=200
MILVUS_EF_SEARCH=64
MILVUS_NLIST=128
MILVUS_NPROBE=16
MILVUS_INSERT_BATCH_SIZE=250

# --------------------- EMBEDDING CONFIGURATION ------------------------------ 
# Options: gemini, openai, or voyage
EMBEDDING_PROVIDER=gemini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL_NAME=gemini-embedding-2

# OpenAI Configuration (Uncomment to use)
# OPENAI_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# Voyage Configuration (Uncomment to use)
# VOYAGE_API_KEY=your_voyage_api_key_here
# EMBEDDING_MODEL_NAME=voyage-3-large

# General Embedding Settings
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_CONTEXT_CHARS=12000

#------------------------- LLM for chat -----------------------------
# Options: groq, openai, gemini, or anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant 

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here

# OpenAI Configuration (Uncomment to use)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (Uncomment to use)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

#---------------------- Firebase -------------------------------
FIREBASE_CREDENTIALS_PATH=backend/firebase-key.json
# Or inject JSON directly via env
# FIREBASE_CREDENTIALS_JSON=your_raw_firebase_credentials_json_string_here

#----------------------- huggingface token & Reranker -----------------
HF_TOKEN=your_huggingface_token_here
BM25_ENABLED=False
RERANKER_ENABLED=False
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=25

# Hugging Face Settings for Windows Compatibility
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
GRPC_VERBOSITY=ERROR

#----------------------- Redis Configuration -----------------
REDIS_URL=redis://localhost:6379/0

#----------------------- Stateless Storage Configuration -----------------
# Choose: local (default) | s3 | gcs
STORAGE_PROVIDER=local

# AWS S3 Settings (Required if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_s3_bucket_name

# Google Cloud Storage Settings (Required if STORAGE_PROVIDER=gcs)
# GCS_BUCKET_NAME=your_gcs_bucket_name
